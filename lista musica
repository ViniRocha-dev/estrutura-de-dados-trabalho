typedef struct Musica {
    char musica[100];
    struct Musica *prox;
    struct Musica *ant;
} Musica;

/* copiar string sem string.h */
void copiarTexto(char destino[], char origem[]) {

    int i = 0;

    while (origem[i] != '\0') {
        destino[i] = origem[i];
        i++;
    }

    destino[i] = '\0';
}

/* adicionar música */
void adicionarMusica(Musica **head, char *nome) {

    Musica *novo = (Musica*) malloc(sizeof(Musica));

    if (novo == NULL) {
        printf("Erro de memoria\n");
        return;
    }

    copiarTexto(novo->musica, nome);

    /* primeira música */
    if (*head == NULL) {

        novo->prox = novo;
        novo->ant = novo;

        *head = novo;
        return;
    }

    Musica *ultimo = (*head)->ant;

    ultimo->prox = novo;

    novo->ant = ultimo;
    novo->prox = *head;

    (*head)->ant = novo;
}

/* próxima música */
void proximaMusica(Musica **atual) {

    if (*atual != NULL) {
        *atual = (*atual)->prox;
    }
}

/* música anterior */
void musicaAnterior(Musica **atual) {

    if (*atual != NULL) {
        *atual = (*atual)->ant;
    }
}

/* exibir playlist */
void exibirPlaylist(Musica *head) {

    if (head == NULL) {
        printf("Playlist vazia\n");
        return;
    }

    Musica *temp = head;

    do {
        printf("[%s] <-> ", temp->musica);
        temp = temp->prox;
    } while (temp != head);

    printf("(volta ao inicio)\n");
}

/* total de músicas */
int totalMusicas(Musica *head) {

    if (head == NULL) {
        return 0;
    }

    int total = 0;
    Musica *temp = head;

    do {
        total++;
        temp = temp->prox;
    } while (temp != head);

    return total;
}

/* tocar playlist uma vez */
void tocarPlaylist(Musica *head) {

    if (head == NULL) {
        return;
    }

    Musica *temp = head;

    printf("\nTocando playlist:\n");

    do {
        printf("Tocando: %s\n", temp->musica);
        temp = temp->prox;
    } while (temp != head);

    printf("Fim da playlist\n");
}

/* liberar playlist */
void liberarPlaylist(Musica *head) {

    if (head == NULL) {
        return;
    }

    Musica *temp = head->prox;

    while (temp != head) {

        Musica *aux = temp;
        temp = temp->prox;
        free(aux);
    }

    free(head);
}

