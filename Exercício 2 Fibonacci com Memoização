#include <stdio.h>
#include <stdlib.h>

/*
Caso base:
    fib(0)=0, fib(1)=1
Redução:
    divide o problema em subproblemas menores
O cache evita recomputação.
*/

long long fib_memo(int n, long long *memo, long long *calls) {
    (*calls)++;

    if (n == 0) return 0;
    if (n == 1) return 1;

    if (memo[n] != -1)
        return memo[n];

    memo[n] = fib_memo(n - 1, memo, calls) + fib_memo(n - 2, memo, calls);
    return memo[n];
}

int main() {
    int n;
    long long calls_naive = 0, calls_memo = 0;

    printf("Digite n: ");
    scanf("%d", &n);

    // versão ingênua para comparação
    long long *dummy = malloc((n + 1) * sizeof(long long));
    for (int i = 0; i <= n; i++) dummy[i] = -1;

    // roda versão ingênua só para comparar chamadas
    long long fib_naive(int n, long long *calls) {
        (*calls)++;
        if (n <= 1) return n;
        return fib_naive(n - 1, calls) + fib_naive(n - 2, calls);
    }

    long long result_naive = fib_naive(n, &calls_naive);

    // memoização
    long long *memo = malloc((n + 1) * sizeof(long long));
    for (int i = 0; i <= n; i++) memo[i] = -1;

    long long result_memo = fib_memo(n, memo, &calls_memo);

    printf("\nFibonacci(%d) = %lld\n", n, result_memo);

    printf("Chamadas (ingenuo): %lld\n", calls_naive);
    printf("Chamadas (memoizacao): %lld\n", calls_memo);

    free(memo);
    free(dummy);

    return 0;
}
